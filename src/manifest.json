{
  "manifest_version": 3,
  "name": "Page Pilot",
  "version": "0.1.0",
  "description": "Extract a page summary prompt and send it to Kimi in the browser side panel.",
  "action": {
    "default_title": "Page Pilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "tabs",
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://kimi.moonshot.cn/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.kimi.com https://kimi.com https://kimi.moonshot.cn;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*"
      ],
      "js": ["deepseek-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
